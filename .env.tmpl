# Evictarr Behaviour
LOG_LEVEL=info
PURGE_STALLED=True
PURGE_STALLED_INTERVAL=300
BLOCK_STALLED_TORRENTS=True
PURGE_IMPORTED=True
PURGE_IMPORTED_INTERVAL=500
DELETE_FILES=True
IGNORE_OTHER_CATEGORIES=False
PURGE_FAILED_IMPORTS=False
# Files: groups are @malware, @executables, @archives, @disc-images, @roms
PURGE_FILES=False
PURGE_EXTENSIONS_INTERVAL=60
BLOCKED_EXTENSIONS=@malware
BLOCKED_NAMES=
SKIPPED_EXTENSIONS=
SKIPPED_NAMES=*sample*
RETRY_SEARCH=True

# Download client: qbittorrent, rdtclient, deluge, transmission or sabnzbd
DOWNLOAD_CLIENT=qbittorrent
TORRENT_AGE=1

# qBittorrent (also used for RDTClient)
QBIT_URL=<<QBITTORRENT IP ADDRESS OR HOSTNAME>>
QBIT_USER=<<qBittorrent Web UI Username>>
QBIT_PASSWORD=<<qBittorrent Web UI Password>>
QBIT_TOKEN_REFRESH_INTERVAL=600

# Deluge (when DOWNLOAD_CLIENT=deluge)
# DELUGE_URL=<<DELUGE WEB UI IP ADDRESS OR HOSTNAME>>
# DELUGE_PASSWORD=<<Deluge Web UI Password>>

# Transmission (when DOWNLOAD_CLIENT=transmission)
# TRANSMISSION_URL=<<TRANSMISSION IP ADDRESS OR HOSTNAME>>
# TRANSMISSION_USER=<<Transmission Username>>
# TRANSMISSION_PASSWORD=<<Transmission Password>>

# SABnzbd (when DOWNLOAD_CLIENT=sabnzbd)
# SABNZBD_URL=<<SABNZBD IP ADDRESS OR HOSTNAME>>
# SABNZBD_API_KEY=<<SABNZBD API KEY>>

# Sonarr
SONARR_URL=<<SONARR IP ADDRESS OR HOSTNAME>>
SONARR_API_KEY=<<SONARR API KEY>>
SONARR_LABELS='tv-sonarr'
SONARR_IMPORTED_LABEL="sonarr-imported"

# Radarr
RADARR_URL=<<RADARR IP ADDRESS OR HOSTNAME>>
RADARR_API_KEY=<<RADARR API KEY>>
RADARR_LABELS='radarr'
RADARR_IMPORTED_LABEL="radarr-imported"
